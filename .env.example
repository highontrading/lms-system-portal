# ─── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Public address of the site (no trailing slash). Used in emails and links.
APP_URL="http://localhost:3000"
# Long random string. Signs links and encrypts saved credentials. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=""

# ─── First run (used by `npm run db:seed`) ───────────────────────────────────
SEED_ADMIN_EMAIL="you@yourdomain.com"
SEED_ADMIN_PASSWORD=""          # leave empty to have one generated and printed once
SEED_ADMIN_NAME="Academy Owner"
SEED_DEMO="true"                # "false" to skip the sample products and students
SEED_DEMO_PASSWORD=""           # password for the sample students (optional)

# ─── Email (optional — can also be set in Admin → Settings → Email) ──────────
# Without a provider, emails are written to the server log and to the email log table.
# EMAIL_PROVIDER="smtp"         # "smtp" | "resend" | "log"
# EMAIL_FROM="hello@yourdomain.com"
# EMAIL_FROM_NAME="Ideabro Academy"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# RESEND_API_KEY=""

# ─── File storage (optional) ─────────────────────────────────────────────────
# Default: files are kept on disk in ./storage (fine for a VPS with a persistent disk).
# On Vercel or any host without a persistent disk, use an S3-compatible bucket instead.
# STORAGE_DRIVER="s3"           # "local" | "s3"
# STORAGE_DIR="./storage"
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT=""                # e.g. https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL=""              # optional public base URL for public files
