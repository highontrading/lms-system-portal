// Ideabro Academy — database schema
// PostgreSQL via Prisma ORM 7. Money is stored in minor units (paise / cents).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  STUDENT
  SUPPORT
  INSTRUCTOR
  ADMIN
  OWNER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
  LOGIN_CODE
  INVITE
}

enum ProductType {
  COURSE
  WORKSHOP
  AGENT
  WORKFLOW
  DIGITAL
  BUNDLE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum Level {
  ALL
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
  ASSIGNMENT
  DOWNLOAD
  EMBED
}

enum VideoProvider {
  YOUTUBE
  VIMEO
  BUNNY
  UPLOAD
  URL
}

enum QuestionType {
  SINGLE
  MULTIPLE
  TRUE_FALSE
  SHORT
}

enum SubmissionStatus {
  SUBMITTED
  PASSED
  NEEDS_REVISION
}

enum LiveStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum AssetKind {
  FILE
  LINK
  SNIPPET
}

enum EnrollmentStatus {
  ACTIVE
  REVOKED
}

enum EnrollmentSource {
  PURCHASE
  FREE
  MANUAL
  API
  IMPORT
  BUNDLE
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
  MANUAL
  EXTERNAL
  FREE
}

enum CouponType {
  PERCENT
  FIXED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum TicketStatus {
  OPEN
  AWAITING_STUDENT
  RESOLVED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
}

enum AnnouncementAudience {
  ALL
  PRODUCT
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum EmailStatus {
  SENT
  LOGGED
  FAILED
}

enum DeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

// ───────────────────────── Users & authentication ─────────────────────────

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  name            String
  passwordHash    String?
  role            Role       @default(STUDENT)
  status          UserStatus @default(ACTIVE)
  avatarUrl       String?
  headline        String?
  bio             String?    @db.Text
  phone           String?
  country         String?
  timezone        String?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  lastActiveAt    DateTime?
  adminNote       String?    @db.Text

  // Email preferences
  emailAnnouncements Boolean @default(true)
  emailReplies       Boolean @default(true)
  emailReminders     Boolean @default(true)
  marketingOptIn     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions        Session[]
  tokens          AuthToken[]
  enrollments     Enrollment[]
  lessonProgress  LessonProgress[]
  quizAttempts    QuizAttempt[]
  submissions     Submission[]       @relation("SubmissionAuthor")
  gradedWork      Submission[]       @relation("SubmissionGrader")
  orders          Order[]
  reviews         Review[]
  threads         Thread[]
  replies         Reply[]
  notes           Note[]
  bookmarks       Bookmark[]
  notifications   Notification[]
  certificates    Certificate[]
  activityDays    ActivityDay[]
  tickets         Ticket[]           @relation("TicketAuthor")
  assignedTickets Ticket[]           @relation("TicketAssignee")
  ticketMessages  TicketMessage[]
  attendances     LiveAttendance[]
  media           Media[]
  announcements   Announcement[]
  apiKeys         ApiKey[]

  @@index([role])
  @@index([createdAt])
}

model Session {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  userId         String
  impersonatorId String?
  userAgent      String?
  ip             String?
  createdAt      DateTime @default(now())
  lastUsedAt     DateTime @default(now())
  expiresAt      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthToken {
  id        String    @id @default(cuid())
  type      TokenType
  email     String
  userId    String?
  tokenHash String    @unique
  codeHash  String?
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, type])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

// ───────────────────────────── Catalog ─────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Instructor {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  title     String?
  bio       String?  @db.Text
  avatarUrl String?
  website   String?
  twitter   String?
  linkedin  String?
  youtube   String?
  instagram String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id         String            @id @default(cuid())
  type       ProductType
  status     ProductStatus     @default(DRAFT)
  visibility ProductVisibility @default(PUBLIC)

  title         String
  slug          String  @unique
  tagline       String?
  description   String? @db.Text
  thumbnailUrl  String?
  promoVideoUrl String?
  categoryId    String?
  level         Level   @default(ALL)
  language      String  @default("English")
  durationLabel String?
  tags          String[]

  // Pricing (minor units, in the store currency)
  price          Int     @default(0)
  compareAtPrice Int?
  checkoutUrl    String?
  sku            String? @unique

  // Sales page content
  outcomes     String[]
  requirements String[]
  audience     String[]
  faqs         Json?

  // Access rules
  accessDays         Int?
  /// Maximum number of active enrolments (null = unlimited). Mostly used for workshops.
  seatLimit          Int?
  sequential         Boolean @default(false)
  certificateEnabled Boolean @default(false)
  completionPercent  Int     @default(100)
  discussionsEnabled Boolean @default(true)
  reviewsEnabled     Boolean @default(true)
  licenseKeysEnabled Boolean @default(false)

  // Agents, workflows and other digital products
  version  String?
  platform String?

  // SEO and merchandising
  seoTitle       String?
  seoDescription String?
  featured       Boolean @default(false)
  position       Int     @default(0)

  // Denormalised review stats, maintained when reviews change
  ratingAverage Float @default(0)
  ratingCount   Int   @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  instructors   Instructor[]
  sections      Section[]
  lessons       Lesson[]
  assets        Asset[]
  liveSessions  LiveSession[]
  updates       ProductUpdate[]
  bundleItems   BundleItem[]   @relation("BundleParent")
  inBundles     BundleItem[]   @relation("BundleChild")
  enrollments   Enrollment[]
  orderItems    OrderItem[]
  coupons       Coupon[]
  reviews       Review[]
  threads       Thread[]
  announcements Announcement[]
  certificates  Certificate[]
  tickets       Ticket[]

  @@index([status, visibility, type])
  @@index([categoryId])
  @@index([featured])
}

model BundleItem {
  bundleId  String
  productId String
  position  Int    @default(0)

  bundle  Product @relation("BundleParent", fields: [bundleId], references: [id], onDelete: Cascade)
  product Product @relation("BundleChild", fields: [productId], references: [id], onDelete: Cascade)

  @@id([bundleId, productId])
  @@index([productId])
}

// ───────────────────────────── Curriculum ─────────────────────────────

model Section {
  id          String   @id @default(cuid())
  productId   String
  title       String
  description String?
  position    Int      @default(0)
  /// Unlock this section N days after enrolment (null = immediately)
  dripDays    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([productId, position])
}

model Lesson {
  id              String         @id @default(cuid())
  productId       String
  sectionId       String
  title           String
  type            LessonType     @default(VIDEO)
  position        Int            @default(0)
  isPublished     Boolean        @default(true)
  isPreview       Boolean        @default(false)
  durationSeconds Int?
  content         String?        @db.Text
  videoProvider   VideoProvider?
  videoUrl        String?
  embedUrl        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  section    Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  assets     Asset[]
  quiz       Quiz?
  assignment Assignment?
  progress   LessonProgress[]
  notes      Note[]
  bookmarks  Bookmark[]
  threads    Thread[]

  @@index([productId])
  @@index([sectionId, position])
}

/// A deliverable: a downloadable file, an external link, or a copyable snippet.
/// Attached to a product (lessonId null) or to one lesson.
model Asset {
  id            String    @id @default(cuid())
  productId     String
  lessonId      String?
  kind          AssetKind @default(FILE)
  title         String
  description   String?
  url           String?
  fileKey       String?
  fileName      String?
  fileSize      Int?
  mimeType      String?
  content       String?   @db.Text
  language      String?
  version       String?
  position      Int       @default(0)
  downloadCount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  lesson  Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@index([lessonId])
}

model Quiz {
  id               String  @id @default(cuid())
  lessonId         String  @unique
  passPercent      Int     @default(70)
  maxAttempts      Int?
  timeLimitMinutes Int?
  shuffleQuestions Boolean @default(false)
  showAnswers      Boolean @default(true)

  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id          String       @id @default(cuid())
  quizId      String
  type        QuestionType @default(SINGLE)
  prompt      String       @db.Text
  /// [{ id, text, correct }]
  options     Json
  explanation String?      @db.Text
  points      Int          @default(1)
  position    Int          @default(0)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, position])
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  userId      String
  /// { [questionId]: string[] | string }
  answers     Json
  score       Int       @default(0)
  maxScore    Int       @default(0)
  percent     Int       @default(0)
  passed      Boolean   @default(false)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId, userId])
  @@index([userId])
}

model Assignment {
  id               String  @id @default(cuid())
  lessonId         String  @unique
  maxPoints        Int     @default(100)
  /// When true the lesson completes on submission; otherwise once marked as passed.
  completeOnSubmit Boolean @default(true)

  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions Submission[]
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  userId       String
  body         String?          @db.Text
  linkUrl      String?
  fileKey      String?
  fileName     String?
  status       SubmissionStatus @default(SUBMITTED)
  grade        Int?
  feedback     String?          @db.Text
  gradedById   String?
  gradedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation("SubmissionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  gradedBy   User?      @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, userId])
  @@index([status])
}

// ───────────────────────────── Live sessions ─────────────────────────────

model LiveSession {
  id                String         @id @default(cuid())
  productId         String
  title             String
  description       String?        @db.Text
  startsAt          DateTime
  durationMinutes   Int            @default(60)
  platform          String?
  meetingUrl        String?
  meetingPasscode   String?
  status            LiveStatus     @default(SCHEDULED)
  recordingProvider VideoProvider?
  recordingUrl      String?
  reminderDaySentAt  DateTime?
  reminderHourSentAt DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  attendances LiveAttendance[]

  @@index([productId, startsAt])
  @@index([startsAt])
}

model LiveAttendance {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  joinedAt  DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

/// Changelog entries: new versions of an agent or workflow, added lessons, etc.
model ProductUpdate {
  id          String   @id @default(cuid())
  productId   String
  version     String?
  title       String
  body        String   @db.Text
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, publishedAt])
}

// ───────────────────────── Access and progress ─────────────────────────

model Enrollment {
  id              String           @id @default(cuid())
  userId          String
  productId       String
  status          EnrollmentStatus @default(ACTIVE)
  source          EnrollmentSource @default(MANUAL)
  orderId         String?
  /// Set when access came from owning a bundle
  bundleId        String?
  expiresAt       DateTime?
  revokedAt       DateTime?
  completedAt     DateTime?
  progressPercent Int              @default(0)
  lastLessonId    String?
  lastAccessedAt  DateTime?
  licenseKey      String?          @unique
  externalRef     String?
  note            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@index([productId, status])
  @@index([createdAt])
}

model LessonProgress {
  id              String    @id @default(cuid())
  userId          String
  lessonId        String
  productId       String
  completedAt     DateTime?
  positionSeconds Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, productId])
  @@index([lessonId])
}

/// One row per user per day they learned — powers streaks and activity charts.
model ActivityDay {
  userId           String
  day              DateTime @db.Date
  lessonsCompleted Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
}

model Certificate {
  id           String    @id @default(cuid())
  serial       String    @unique
  userId       String
  productId    String?
  studentName  String
  productTitle String
  issuedAt     DateTime  @default(now())
  revokedAt    DateTime?
  revokeReason String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@index([productId])
}

// ───────────────────────────── Commerce ─────────────────────────────

model Order {
  id               String         @id @default(cuid())
  /// Gap-free sequence used to build the human-readable order / invoice number
  seq              Int            @unique @default(autoincrement())
  number           String         @unique
  userId           String?
  email            String
  name             String?
  status           OrderStatus    @default(PENDING)
  currency         String
  subtotal         Int
  discount         Int            @default(0)
  total            Int
  couponId         String?
  couponCode       String?
  gateway          PaymentGateway
  gatewayOrderId   String?
  gatewayPaymentId String?
  /// Idempotency key for orders created through the API or imports
  externalRef      String?        @unique
  billingName      String?
  billingPhone     String?
  billingAddress   String?
  billingTaxId     String?
  note             String?        @db.Text
  meta             Json?
  paidAt           DateTime?
  refundedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon      Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  enrollments Enrollment[]

  @@index([userId])
  @@index([status, createdAt])
  @@index([gatewayOrderId])
  @@index([email])
}

model OrderItem {
  id        String      @id @default(cuid())
  orderId   String
  productId String?
  title     String
  type      ProductType
  price     Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  description    String?
  type           CouponType @default(PERCENT)
  /// Percent (1–100) or a fixed amount in minor units
  value          Int
  maxRedemptions Int?
  perUserLimit   Int        @default(1)
  redeemedCount  Int        @default(0)
  minAmount      Int?
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  /// Empty = valid for every product
  products Product[]
  orders   Order[]
}

// ───────────────────────────── Engagement ─────────────────────────────

model Review {
  id         String       @id @default(cuid())
  productId  String
  userId     String
  rating     Int
  title      String?
  body       String?      @db.Text
  status     ReviewStatus @default(PUBLISHED)
  reply      String?      @db.Text
  repliedAt  DateTime?
  isFeatured Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([status])
}

model Thread {
  id             String   @id @default(cuid())
  productId      String
  lessonId       String?
  userId         String
  title          String
  body           String   @db.Text
  isPinned       Boolean  @default(false)
  isResolved     Boolean  @default(false)
  isLocked       Boolean  @default(false)
  replyCount     Int      @default(0)
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  lesson  Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies Reply[]

  @@index([productId, lastActivityAt])
  @@index([lessonId])
}

model Reply {
  id        String   @id @default(cuid())
  threadId  String
  userId    String
  body      String   @db.Text
  isAnswer  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model Note {
  id              String   @id @default(cuid())
  userId          String
  lessonId        String
  productId       String
  body            String   @db.Text
  positionSeconds Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, productId])
  @@index([userId, lessonId])
}

model Bookmark {
  userId    String
  lessonId  String
  productId String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  body        String               @db.Text
  audience    AnnouncementAudience @default(ALL)
  productId   String?
  isPinned    Boolean              @default(false)
  publishedAt DateTime?
  emailedAt   DateTime?
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([publishedAt])
  @@index([productId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ───────────────────────────── Support ─────────────────────────────

model Ticket {
  id            String         @id @default(cuid())
  number        Int            @unique @default(autoincrement())
  userId        String
  productId     String?
  subject       String
  status        TicketStatus   @default(OPEN)
  priority      TicketPriority @default(NORMAL)
  assigneeId    String?
  lastMessageAt DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user     User            @relation("TicketAuthor", fields: [userId], references: [id], onDelete: Cascade)
  assignee User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  product  Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  messages TicketMessage[]

  @@index([status, lastMessageAt])
  @@index([userId])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  body      String   @db.Text
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ───────────────────────── Site content & settings ─────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Page {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  body           String   @db.Text
  seoDescription String?
  isPublished    Boolean  @default(true)
  showInFooter   Boolean  @default(true)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Media {
  id           String          @id @default(cuid())
  key          String          @unique
  fileName     String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  visibility   MediaVisibility @default(PUBLIC)
  alt          String?
  uploadedById String?
  createdAt    DateTime        @default(now())

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([visibility])
}

// ───────────────────────── Integrations & logs ─────────────────────────

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  prefix      String
  keyHash     String    @unique
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
}

model WebhookEndpoint {
  id          String   @id @default(cuid())
  url         String
  description String?
  /// Encrypted signing secret
  secret      String
  events      String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id             String         @id @default(cuid())
  endpointId     String
  event          String
  payload        Json
  status         DeliveryStatus @default(PENDING)
  responseStatus Int?
  responseBody   String?
  attempts       Int            @default(0)
  nextAttemptAt  DateTime?
  createdAt      DateTime       @default(now())
  deliveredAt    DateTime?

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@index([status, nextAttemptAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entityType String?
  entityId   String?
  summary    String
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

model EmailLog {
  id        String      @id @default(cuid())
  to        String
  subject   String
  template  String?
  status    EmailStatus
  provider  String?
  error     String?
  html      String?     @db.Text
  createdAt DateTime    @default(now())

  @@index([createdAt])
  @@index([to])
}
